# Base PostgreSQL (production). Laissez vide en local : une base embarquée (PGlite)
# est alors créée automatiquement dans .data/pglite.
# Neon : utilisez la chaîne de connexion « pooled » (avec -pooler dans l'hôte).
DATABASE_URL=

# Adresse publique du site, utilisée dans les liens des e-mails.
# Facultatif sur Netlify et Vercel (détectée automatiquement).
APP_URL=

# Envoi d'e-mails (mot de passe oublié) via n'importe quel serveur SMTP.
# Exemple Brevo : SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, mot de passe d'application
# Sans SMTP_HOST en local, les e-mails s'affichent dans la console du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="YOUBA SERVICE <adresse@exemple.com>"
